# Salin fail ini ke .env.local (untuk dev tempatan) dan isi nilai sebenar.
# Untuk Vercel: tetapkan pembolehubah ini di Project Settings -> Environment Variables.
# JANGAN commit nilai sebenar ke dalam repo — fail .env.local sudah di-.gitignore.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Diperlukan oleh app/api/ingest/chat-log dan app/api/ingest/issues sahaja.
# Service-role key dari Supabase project settings (bypass RLS) — server-only,
# jangan sekali-kali dedahkan di sisi klien.
SUPABASE_SERVICE_ROLE_KEY=

# Rentetan rawak yang mesti sepadan dengan SECRET dalam kedua-dua
# google-apps-script/*.gs — digunakan untuk sahkan setiap webhook push.
INGEST_SECRET=
